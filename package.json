{
  "name": "@betterapps/platform-client",
  "version": "0.2.1",
  "description": "Drop-in client for the BA platform (Mantle-compatible API surface)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterAppsLT/platform-client.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
